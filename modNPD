Private Sub funcGenerateNPDArrangement_Click()
    
    ThisWorkbook.Sheets("NPD").Columns("A").ClearFormats
    
    '------------------------------------------------------------
    ' 1. Get the NPD_Count/WIP_Count/FinalStep_Count for looping
    '------------------------------------------------------------
    Dim NPD_Count As Long
    NPD_Count = ThisWorkbook.Sheets("NPD").Range("A" & Rows.Count).End(xlUp).Row
    NPD_Data = ThisWorkbook.Sheets("NPD").Range("A1:B" & NPD_Count).Value
    
    '----------------------------
    ' 2. Generate WIP_Dictionary
    '----------------------------
    Dim WIP_Count As Long, _
        WIP_Data As Variant, _
        WIP_Dictionary As Object
    
    WIP_Count = ThisWorkbook.Sheets("WIP").Range("B" & Rows.Count).End(xlUp).Row
    WIP_Data = ThisWorkbook.Sheets("WIP").Range("B1:E" & WIP_Count).Value
    Set WIP_Dictionary = CreateObject("Scripting.Dictionary")
    
    For i = 1 To UBound(WIP_Data, 1)
    
        WIP_Schedule = CStr(WIP_Data(i, 1))
        WIP_CustomerCode = Mid(WIP_Schedule, 3, 2)
        WIP_Device = CStr(WIP_Data(i, 2))
        WIP_CurrentStep = CStr(WIP_Data(i, 3))
            
        Set WIP_SingleEntryDictionary = CreateObject("Scripting.Dictionary")
        WIP_SingleEntryDictionary.Add "CustomerCode", WIP_CustomerCode
        WIP_SingleEntryDictionary.Add "Device", WIP_Device
        WIP_SingleEntryDictionary.Add "CurrentStep", WIP_CurrentStep
        
        If Not WIP_Dictionary.exists(WIP_Schedule) Then
            WIP_Dictionary.Add WIP_Schedule, WIP_SingleEntryDictionary
        End If
        
    Next
    
    '--------------------------------
    ' 3. Generate Routing_Dictionary
    '--------------------------------
    Dim Routing_StepCount As Long, _
        Routing_Data As Variant, _
        Routing_Dictionary As Object
    
    Routing_StepCount = ThisWorkbook.Sheets("Routing").Range("B" & Rows.Count).End(xlUp).Row
    Routing_Data = ThisWorkbook.Sheets("Routing").Range("B1:E" & Routing_StepCount).Value
    Set Routing_Dictionary = CreateObject("Scripting.Dictionary")
    
    For i = 1 To UBound(Routing_Data, 1)
    
        Routing_StepName = CStr(Routing_Data(i, 1))
        Routing_StepsTilFinal = Routing_Data(i, 2)
        Routing_StepRemarks = CStr(Routing_Data(i, 3))
            
        Set Routing_SingleEntryDictionary = CreateObject("Scripting.Dictionary")
        Routing_SingleEntryDictionary.Add "StepsTilFinal", Routing_StepsTilFinal
        Routing_SingleEntryDictionary.Add "Remarks", Routing_StepRemarks
        
        If Not Routing_Dictionary.exists(Routing_StepName) Then
            Routing_Dictionary.Add Routing_StepName, Routing_SingleEntryDictionary
        End If
        
    Next
    
    
    Dim NPD_Arrangement(1 To 100, 1 To 6) As String
    For i = 1 To NPD_Count
    
        '------------------------------------------
        ' 4. Get NPD_Schedule and NPD_CustomerCode
        '------------------------------------------
        NPD_Schedule = ThisWorkbook.Sheets("NPD").Range("A" & i)
        NPD_CustomerCode = Mid(NPD_Schedule, 3, 2)
        
        NPD_Arrangement(i, 1) = NPD_Schedule
        NPD_Arrangement(i, 2) = NPD_CustomerCode
        
        '---------------------------------------------
        ' 4.1 Get NPD_CurrentStep from WIP_Dictionary
        '---------------------------------------------
        NPD_CurrentStep = "Not in WIP"
        If WIP_Dictionary.exists(NPD_Schedule) Then
            
            NPD_CurrentStep = WIP_Dictionary(NPD_Schedule)("CurrentStep")
            NPD_Arrangement(i, 3) = NPD_CurrentStep
        
            '-----------------------------------------------
            ' 4.2 Get NPD_StepsTilFinal and NPD_StepRemarks
            '-----------------------------------------------
            NPD_StepsTilFinal = Routing_Dictionary(NPD_CurrentStep)("StepsTilFinal")
            NPD_Arrangement(i, 4) = NPD_StepsTilFinal
            
            NPD_StepRemarks = Routing_Dictionary(NPD_CurrentStep)("Remarks")
            NPD_Arrangement(i, 5) = NPD_StepRemarks
                 
        End If
    Next
    
    ThisWorkbook.Sheets("NPD").Range("G1:K" & NPD_Count).Value = NPD_Arrangement
    
End Sub





