Public WithEvents checkbox As MSForms.Label

Dim pRow As Integer
Dim pRange As Range
Dim pActive As Boolean
Dim pSwitch As Range

Public Property Get Row() As Integer
    Row = pRow
End Property
Public Property Let Row(x As Integer)
    pRow = x
End Property



Public Property Set Range(r As Range)
    Set pRange = r
End Property


Private Sub UI_ActivateCheckBox(ByRef checkbox As Object)
    'rgba(241,142,51,255)
    checkbox.BackColor = RGB(255, 147, 0)
    checkbox.ForeColor = RGB(0, 0, 0)
    
End Sub

Private Sub UI_DeactivateCheckBox(ByRef checkbox As Object)
    
    If pRange.Value Then checkbox.BackColor = RGB(220, 234, 247)
        
End Sub

Private Sub checkbox_Click()
    
    x = Int(Split(checkbox.Name, "_")(1))
    y = Int(Split(checkbox.Name, "_")(2))

    MaxStepCount = ThisWorkbook.Sheets(1).Range("C6").Value
    Set pSwitch = ThisWorkbook.Sheets(2).Range("B2").Offset(x - 1, y - 1)
    
    ScheduleMaxStepCount = ThisWorkbook.Sheets("Switches").Cells(1 + x, Columns.Count).End(xlToLeft).Column - 1
    If y > ScheduleMaxStepCount Then Exit Sub
    
    
    For j = 1 To ScheduleMaxStepCount
        Active = pRange.Value
        
        If j <> y Then
            Set instanceSwitch = ThisWorkbook.Sheets(2).Range("B2").Offset(x - 1, j - 1)
            If instanceSwitch.Value = True Then instanceSwitch.Value = False
            
            BackColor = RGB(240, 240, 240)
            'If instanceSwitch.Value = False And Len(instanceSwitch.Value) > 0 Then BackColor = RGB(220, 234, 247)
            
            formAutoInkout.Controls("checkStep_" & Format(x, "00") & "_" & Format(j, "00")).BackColor = BackColor
            
        End If
        
        
    Next
    
    If pRange.Value = True Then
    
        UI_DeactivateCheckBox checkbox
        
        
        pRange.Value = False
         
    ElseIf pRange.Value = False Then
        
        UI_ActivateCheckBox checkbox
        pRange.Value = True
        Schedule = ThisWorkbook.Sheets(2).Range("A2").Offset(x - 1, 0).Value
        Step = ThisWorkbook.Sheets(2).Range("B1").Offset(0, y - 1).Value
        
        'formAutoInkout.Controls("lblRemarks_" & Format(x, "00")).Caption = Remarks
        
    End If
    
    
    Schedule = ThisWorkbook.Sheets("Subfolders").Range("B2").Offset(x, 0).Value
    CumulativeCount = ThisWorkbook.Sheets("Subfolders").Range("E2").Offset(x, 0).Value
    
    
    InkoutMapDirectory = ThisWorkbook.Sheets("Subfolders").Range("G3").Offset(CumulativeCount + y - 1, 0).Value
    
    
    Directory = InkoutMapDirectory & "\" & checkbox.Caption
    
    InkoutMapList = Module1.GetMapList(InkoutMapDirectory)
    
    If IsEmpty(InkoutMapList) Then
        MsgBox "No maps"
        Exit Sub
    End If
    'Remarks = ""
    Dim Remarks(1 To 12) As String, ImpactRemarks() As String
    Dim ImpactWaferCount As Integer
    For Each Map In InkoutMapList
        
        filePath = InkoutMapDirectory & "\" & Map
        
        InkoutMapWaferID = Module1.GetWaferID(filePath)
        DefectCount = Module1.CountF30(filePath)
        If DefectCount > 0 Then
            ImpactWaferCount = ImpactWaferCount + 1
            Remarks(InkoutMapWaferID) = "S" & InkoutMapWaferID & "-" & DefectCount & "ea"
        
            'Remarks = Remarks & ",S" & InkoutMapWaferID & "-" & Module1.CountF30(filePath) & "ea"
        End If
    Next
    
    
    
    If ImpactWaferCount = 0 Then
        RemarksString = "No F30 detected"
        formAutoInkout.Controls("lblRemarks_" & Format(x, "00")).Caption = RemarksString
        Exit Sub
    End If
    
    ReDim ImpactRemarks(0 To ImpactWaferCount - 1)
    Dim Count As Integer
    Count = 0
    For i = 1 To 12
        Remark = Remarks(i)
        If Remark <> "" Then
            
            ImpactRemarks(Count) = Remark
            Count = Count + 1
        End If
    
    Next
    
    RemarksString = Join(ImpactRemarks, ",")
    
    formAutoInkout.Controls("lblRemarks_" & Format(x, "00")).Caption = RemarksString
    
End Sub



