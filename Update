Option Explicit

Public NextRunTime As Date

Sub StartScheduler()
    ' Schedule the first run 30 minutes from now
    NextRunTime = Now + TimeValue("00:00:05")
    Application.OnTime NextRunTime, "TaskToRun"
End Sub

Sub TaskToRun()
    ' >>> Put your actual task here <<<
    Call MyProcess

    ' Reschedule the next run
    NextRunTime = Now + TimeValue("00:00:05")
    Application.OnTime NextRunTime, "TaskToRun"
End Sub

Sub StopScheduler()
    ' Cancel the next scheduled run
    On Error Resume Next
    Application.OnTime NextRunTime, "TaskToRun", , False
End Sub

