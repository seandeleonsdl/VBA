Private Sub ScanResults_CheckCamtek()
    
        
    '--------------------------
    ' 1 Check Camtek Directory
    '--------------------------
    Camtek_Directory = "\\10.16.207.237\6905\FX_Camtek"
    Camtek_Directory = "C:\Users\Sean\OneDrive\Desktop\FX_Camtek"
    
    '----------------------------
    ' 2 Loop all Camtek Machines
    '----------------------------
    
    Marvel_Recipes = ""
    
    Camtek_Folder = Dir(Camtek_Directory & "\", vbDirectory)
    Camtek_Machines = ""
    Do While Camtek_Folder <> ""
        
        '------------------------
        ' File Filter Conditions
        '------------------------
        IsMachineFolder = Len(Camtek_Folder) > 2
        
        If IsMachineFolder Then
            Camtek_Machines = Camtek_Machines & "|" & Camtek_Directory & "\" & Camtek_Folder
        End If
        Camtek_Folder = Dir
    Loop
    If Len(Camtek_Machines) > 0 Then Camtek_Machines = Right(Camtek_Machines, Len(Camtek_Machines) - 1)
    'MsgBox Replace(Camtek_Machines, "|", vbNewLine)

    '---------------------------
    ' 3 Loop all Camtek Recipes
    '---------------------------
    IsMarvelRecipe = False
    Marvel_Recipes = ""
    
    For Each Machine In Split(Camtek_Machines, "|")
    
        Folder = Dir(Machine & "\", vbDirectory)
        Do While Folder <> ""
            
            '------------------------
            ' File Filter Conditions
            '------------------------
            IsMarvelRecipe = Len(Folder) > 2
            IsMarvelRecipe = InStr(1, Folder, "2L22")
            
            If IsMarvelRecipe Then
                Marvel_Recipes = Marvel_Recipes & "|" & Machine & "\" & Folder
            End If
            Folder = Dir
        Loop
        
    Next
    If Len(Marvel_Recipes) > 0 Then Marvel_Recipes = Right(Marvel_Recipes, Len(Marvel_Recipes) - 1)
    
    '-------------------------------
    ' 4 Check all Schedules scanned
    '-------------------------------
    Dim RecentScan_Schedule As String, RecentScan_Step As String, RecentScan_Path As String
    Dim RecentScan_LotDetails(1 To 100, 1 To 3) As String
    Dim RecentScan_Count As Integer
    
    For Each Recipe In Split(Marvel_Recipes, "|")
        
        Folder = Dir(Recipe & "\", vbDirectory)

        
        Do While Folder <> ""
            
            '------------------------
            ' File Filter Conditions
            '------------------------
            IsLotSchedule = Len(Folder) >= 6
            
            RecentlyScanned = False
            
            If IsLotSchedule Then
                
                RecentScan_ScanDate = FileDateTime(Recipe & "\" & Folder)
                
                RecentlyScanned = DateDiff("d", Now, RecentScan_ScanDate) < 4
            End If
            
            If RecentlyScanned Then
                
                RecentScan_Count = RecentScan_Count + 1
                
                RecentScan_Schedule = Folder
                RecentScan_Step = Split(Recipe, "-")(UBound(Split(Recipe, "-")))
                RecentScan_Path = Recipe & "\" & RecentScan_Schedule
                
                RecentScan_LotDetails(RecentScan_Count, 1) = RecentScan_Schedule
                RecentScan_LotDetails(RecentScan_Count, 2) = RecentScan_Step
                RecentScan_LotDetails(RecentScan_Count, 3) = RecentScan_Path
                
            End If
            
           
            Folder = Dir
        Loop
    Next
    
    '----------------------------
    ' 5 Check all Wafers scanned
    '----------------------------
    Dim RecentScan_Schedule As String, RecentScan_Step As String, RecentScan_Path As String
    Dim RecentScan_LotDetails(1 To 100, 1 To 3) As String
    Dim RecentScan_Count As Integer
    
    For i = 1 To RecentScan_Count
        
        Schedule = RecentScan_LotDetails(i, 3)
        Folder = Dir(Schedule & "\", vbDirectory)

        Do While Folder <> ""
            
            '------------------------
            ' File Filter Conditions
            '------------------------
            IsWaferID = Len(Folder) > 2
            
        
            
            
                
            RecentScan_Count = RecentScan_Count + 1
                
            RecentScan_Schedule = Folder
            RecentScan_Step = Split(Recipe, "-")(UBound(Split(Recipe, "-")))
            RecentScan_Path = Recipe & "\" & RecentScan_Schedule
                
            RecentScan_LotDetails(RecentScan_Count, 1) = RecentScan_Schedule
            RecentScan_LotDetails(RecentScan_Count, 2) = RecentScan_Step
            RecentScan_LotDetails(RecentScan_Count, 3) = RecentScan_Path
                
            End If
            
           
            Folder = Dir
        Loop
    Next
    
    
    
    
    Dim EntryCount As Integer
    EntryCount = ThisWorkbook.Sheets("Scan Results").Range("A" & Rows.Count).End(xlUp).Row - 1
    ThisWorkbook.Sheets("Scan Results").Range("A2:C" & 1 + RecentScan_Count).Offset(EntryCount, 0).Value = RecentScan_LotDetails
    
    
    
    
    
    
End Sub


Private Sub ScanResults_CheckCMIt()
    
