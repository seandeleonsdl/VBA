Public Sub funcLoadMESCurrentWIP()
    
    Set wbWIP = Application.Workbooks.Open("\\10.10.20.70\Bumping5\Other\Sean\MES WIP\MES_CURR WIP_(Security C).xlsx")
    
    '1. Create Headers for the WIP Summary
    Dim WIP_Summary(0 To 60000, 1 To 6) As Variant
    WIP_Summary(0, 1) = "SCHEDULE"
    WIP_Summary(0, 2) = "DEVICE"
    WIP_Summary(0, 3) = "STEP"
    WIP_Summary(0, 4) = "HOLD COMMENT"
     
     '2. Filter out MES_CURR_WIP
    Dim WIP_Count As Long, WIP_InterestCount As Long
    WIP_Count = wbWIP.Sheets(1).Range("B" & Rows.Count).End(xlUp).Row - 1
    WIP_InterestCount = 0
    For i = 1 To WIP_Count
        
        WIP_Plant = Right(wbWIP.Sheets(1).Range("B2").Offset(i - 1, 0).Value2, 2)
        If WIP_Plant = "B1" Or WIP_Plant = "B5" Or WIP_Plant = "B6" Then
            
            WIP_InterestCount = WIP_InterestCount + 1
            
            WIP_Schedule = wbWIP.Sheets(1).Range("C2").Offset(i - 1, 0).Value2
            WIP_Device = wbWIP.Sheets(1).Range("O2").Offset(i - 1, 0).Value2
            WIP_Step = wbWIP.Sheets(1).Range("G2").Offset(i - 1, 0).Value2
            WIP_HoldComment = wbWIP.Sheets(1).Range("BF2").Offset(i - 1, 0).Value2
            
            WIP_Summary(WIP_InterestCount, 1) = WIP_Schedule
            WIP_Summary(WIP_InterestCount, 2) = WIP_Device
            WIP_Summary(WIP_InterestCount, 3) = WIP_Step
            WIP_Summary(WIP_InterestCount, 4) = WIP_HoldComment
            
        End If
    Next
    
    wbWIP.Close
    
    '3. Clear previous value but not formatting
    ThisWorkbook.Sheets("WIP").UsedRange.Value = ""
    ThisWorkbook.Sheets("WIP").Range("A1:D" & 1 + WIP_InterestCount).Value2 = WIP_Summary
    
End Sub

Public Function funcGetBorrowMachine_FilesInPath(ByVal BorrowMachine_Directory As String) As Variant
        
        Dim BorrowMachine_FilesInPathCount As Integer, _
        BorrowMachine_File As String, _
        BorrowMachine_FilesInPath(1 To 10) As String

        BorrowMachine_FilesInPathCount = 0
        If Right(BorrowMachine_Directory, 1) <> "\" Then BorrowMachine_Directory = BorrowMachine_Directory & "\"
        BorrowMachine_File = Dir(BorrowMachine_Directory)
        Do While BorrowMachine_File <> ""
        
            ' File Filter Conditions
            FileIsExcelFile = InStr(1, BorrowMachine_File, ".xls") > 0
            
            If FileIsExcelFile Then
                BorrowMachine_FilesInPathCount = BorrowMachine_FilesInPathCount + 1
                BorrowMachine_FilesInPath(BorrowMachine_FilesInPathCount) = BorrowMachine_File
            End If
            BorrowMachine_File = Dir
        Loop
    
        funcGetBorrowMachine_FilesInPath = BorrowMachine_FilesInPath

End Function

Public Function funcGetBorrowMachine_ClosestFile(ByVal BorrowMachine_FilesInPath As Variant, BorrowMachine_FilesInPathCount As Integer) As String
        
        Dim ShiftDate As Date, ShiftDate_BorrowMachineFormat As Long
        ShiftDate = Date - IIf(Time < TimeValue("09:00:00"), 1, 0)
        ShiftDate_BorrowMachineFormat = CLng(Format(ShiftDate, "mmdd"))
            
        BorrowMachine_ClosestDate = 0
        BorrowMachine_ClosestFile = ""
            
        For i = 1 To BorrowMachine_FilesInPathCount
        
                ' 2.2 Extract date from file
                BorrowMachine_File = BorrowMachine_FilesInPath(i)
                BorrowMachine_FileDate = CLng(Right(Split(BorrowMachine_File, "_")(1), 4))
        
                If BorrowMachine_FileDate <= ShiftDate_BorrowMachineFormat Then
                        If BorrowMachine_FileDate > BorrowMachine_ClosestDate Then
                                BorrowMachine_ClosestDate = BorrowMachine_FileDate
                                BorrowMachine_ClosestFile = BorrowMachine_File
                        End If
                End If
        Next
        
        funcGetBorrowMachine_ClosestFile = BorrowMachine_ClosestFile

End Function


Public Sub funcLoadBorrowMachine()

        ' 1. Loop through all files in BorrowMachine_Directory
        Dim BorrowMachine_Directory As String, _
                BorrowMachine_FilesInPath As Variant, _
                BorrowMachine_FilesInPathCount As Integer
        
        BorrowMachine_Directory = ThisWorkbook.Sheets("Machine Address").Range("P5").Value
        BorrowMachine_FilesInPath = funcGetBorrowMachine_FilesInPath(BorrowMachine_Directory)
        BorrowMachine_FilesInPathCount = UBound(BorrowMachine_FilesInPath) - LBound(BorrowMachine_FilesInPath)
        If BorrowMachine_FilesInPathCount = 0 Then
                MsgBox "No Excel files found in Borrow Machine directory."
                Exit Sub
        End If

        ' 2. Find the BorrowMachine_ClosestFile for the ShiftDate
        Dim BorrowMachine_ClosestFile As String
        BorrowMachine_ClosestFile = funcGetBorrowMachine_ClosestFile(BorrowMachine_FilesInPath, BorrowMachine_FilesInPathCount)
        
        If BorrowMachine_ClosestFile = "" Then
                MsgBox "Borrow Machine not found. Please confirm.", vbCritical
                Exit Sub
        End If
    
        ' 3. Read BorrowMachine
        Dim BorrowMachine_LastEntry As Long, _
        BorrowMachine_Entry As String, _
        BorrowMachine_Schedule(1 To 100, 1 To 2) As String, _
        BorrowMachine_LotCount As Integer, _
        BorrowMachine_CustomerList(1 To 10, 1 To 4) As Variant, _
        BorrowMachine_CustomerCount As Integer, _
        BorrowMachine_ScheduleDictionary As Object
        Set BorrowMachine_ScheduleDictionary = CreateObject("Scripting.Dictionary")
        
        Set wbBorrowMachine = Application.Workbooks.Open(BorrowMachine_Directory & BorrowMachine_ClosestFile, 3)
        BorrowMachine_LastEntry = wbBorrowMachine.Sheets("Inspection").Range("F" & Rows.Count).End(xlUp).Row


        For i = 4 To BorrowMachine_LastEntry
                ' 3.1 Check if BorrowMachine_Entry is a ScheduleID
                BorrowMachine_Entry = wbBorrowMachine.Sheets("Inspection").Range("F" & i).Value
                
                
                If Len(BorrowMachine_Entry) < 6 Then GoTo NextIteration
                                
                BorrowMachine_CustomerCode = Mid(BorrowMachine_Entry, 3, 2)
                If Not BorrowMachine_ScheduleDictionary.exists(BorrowMachine_CustomerCode) Then
                        BorrowMachine_ScheduleDictionary.Add BorrowMachine_CustomerCode, CreateObject("Scripting.Dictionary")
                End If
                        
                If Not BorrowMachine_ScheduleDictionary(BorrowMachine_CustomerCode).exists(BorrowMachine_Entry) Then
                        'BorrowMachine_ScheduleDictionary(BorrowMachine_CustomerCode).Add BorrowMachine_Entry, CreateObject("Scripting.Dictionary")
                        ' 3.3 Check BorrowMachine_Priortiy for the BorrowMachine_Entry
                        If VarType(wbBorrowMachine.Sheets("Inspection").Range("A" & i).Value) = 10 Then
                                BorrowMachine_EntryPriority = "PRIO N/A"
                        Else
                                BorrowMachine_EntryPriority = "PRIO " & wbBorrowMachine.Sheets("Inspection").Range("A" & i).Value2
                                If wbBorrowMachine.Sheets("Inspection").Range("A" & i).Value = "" Then BorrowMachine_Priority = "NO PRIO"
                        End If
                        BorrowMachine_ScheduleDictionary(BorrowMachine_CustomerCode)(BorrowMachine_Entry) = BorrowMachine_Priority
                End If
        
NextIteration:
    Next
    
    
    For Each Customer In BorrowMachine_ScheduleDictionary.keys
        BorrowMachine_ScheduleDictionary (Customer)
    Next
    
    For i = 1 To BorrowMachine_CustomerCount
        If i > 1 Then BorrowMachine_CustomerList(i, 3) = BorrowMachine_CustomerList(i - 1, 2) + BorrowMachine_CustomerList(i - 1, 3)
    Next
    
    '-------------------------------------
    ' 4. Create the BorrowMachine_Summary
    '-------------------------------------
    Dim BorrowMachine_Summary() As String
    ReDim BorrowMachine_Summary(1 To BorrowMachine_LotCount, 1 To 2)
    
    For i = 1 To BorrowMachine_LotCount
    
        Summary_LotID = BorrowMachine_Schedule(i, 1)
        Summary_CustomerCode = Mid(Summary_LotID, 3, 2)
        Summary_Priority = BorrowMachine_Schedule(i, 2)
        
        For j = 1 To BorrowMachine_CustomerCount
            If BorrowMachine_CustomerList(j, 1) = Summary_CustomerCode Then
                
                Summary_CumulativeCount = BorrowMachine_CustomerList(j, 3)
                
                BorrowMachine_CustomerList(j, 4) = BorrowMachine_CustomerList(j, 4) + 1
                BorrowMachine_Summary(Summary_CumulativeCount + BorrowMachine_CustomerList(j, 4), 1) = Summary_LotID
                BorrowMachine_Summary(Summary_CumulativeCount + BorrowMachine_CustomerList(j, 4), 2) = Summary_Priority
                Exit For
            End If
            
        Next
    Next
'    MsgBox "A1:B" & BorrowMachine_LotCount
    wbBorrowMachine.Close
    ThisWorkbook.Sheets("NPD").Range("A1:B" & BorrowMachine_LotCount).Value = BorrowMachine_Summary
    
    
End Sub

