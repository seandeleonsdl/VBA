Private Sub UserForm_Initialize()
                    
    '------------------------
    ' 1. Retrieve PROPERTIES
    '------------------------
    Dim wsSettings As Worksheet
    Set wsSettings = ThisWorkbook.Sheets("Settings")
    PROPERTIES_PanelMapDirectory = wsSettings.Range("B2").Value2
    PROPERTIES_InkoutMapDirectory = wsSettings.Range("B3").Value2
    PROPERTIES_MergeMapDirectory = wsSettings.Range("B4").Value2
    PROPERTIES_MaxScheduleCount = wsSettings.Range("B5").Value2
    PROPERTIES_MaxStepCount = wsSettings.Range("B6").Value2
    
    PROPERTIES_StepsWidth = 42
    PROPERTIES_StepsHeight = 30
    PROPERTIES_ScheduleWidth = 65
    PROPERTIES_RowHeight = 22
    Padding = 2
    
    ReDim checkStep(1 To PROPERTIES_MaxScheduleCount, 1 To PROPERTIES_MaxStepCount)
    ReDim LABEL_Schedule(1 To PROPERTIES_MaxScheduleCount) As Object
    ReDim LABEL_ScheduleBackground(1 To PROPERTIES_MaxScheduleCount) As Object
    
    
    Me.txtPanelMapDirectory.Value = PROPERTIES_PanelMapDirectory
    Me.txtInkoutMapDirectory.Value = PROPERTIES_InkoutMapDirectory
    Me.txtMergeMapDirectory.Value = PROPERTIES_MergeMapDirectory
    
    subSetCSSStyling
    
    
    '-----------------------------
    ' 2. Set-up Userform Controls
    '-----------------------------
    For i = 1 To PROPERTIES_MaxScheduleCount
        
        '---------------------------------
        ' 2.1 Setup lblScheduleBackground
        '---------------------------------
        Set LABEL_ScheduleBackground(i) = Me.Controls.Add("Forms.Label.1", "lblScheduleBackground_" & Format(i, "00"), True)
        LABEL_ScheduleBackground(i).Width = PROPERTIES_ScheduleWidth
        LABEL_ScheduleBackground(i).Height = PROPERTIES_RowHeight
        LABEL_ScheduleBackground(i).Left = Me.lblWorkArea.Left + Padding
        LABEL_ScheduleBackground(i).Top = Me.lblWorkArea.Top + PROPERTIES_RowHeight + Padding + (PROPERTIES_RowHeight + Padding) * (i - 1)
        
        LABEL_ScheduleBackground(i).BackColor = RGB(250, 250, 250)
        
        '-----------------------
        ' 2.2 Setup lblSchedule
        '-----------------------
        Set LABEL_Schedule(i) = Me.Controls.Add("Forms.Label.1", "lblSchedule_" & Format(i, "00"), True)
        LABEL_Schedule(i).Width = PROPERTIES_ScheduleWidth
        LABEL_Schedule(i).Height = PROPERTIES_RowHeight
        LABEL_Schedule(i).Left = LABEL_ScheduleBackground(i).Left + 6
        LABEL_Schedule(i).Top = LABEL_ScheduleBackground(i).Top + 4
        
        LABEL_Schedule(i).BackStyle = fmBackStyleTransparent
        LABEL_Schedule(i).Caption = ""
        LABEL_Schedule(i).Font.Name = "Courier New"
        LABEL_Schedule(i).Font.Size = 8
        
        '----------------------
        ' 2.3 Setup lblRemarks
        '----------------------
        Set labelInstance = Me.Controls.Add("Forms.Label.1", "lblRemarks_" & Format(i, "00"), True)
        labelInstance.Left = LABEL_ScheduleBackground(i).Left + LABEL_ScheduleBackground(i).Width + Padding + (PROPERTIES_StepsWidth + Padding) * (PROPERTIES_MaxStepCount)
        labelInstance.Top = LABEL_ScheduleBackground(i).Top
        labelInstance.Width = 180
        labelInstance.Height = PROPERTIES_RowHeight
        
        labelInstance.BackColor = RGB(250, 250, 250)
        labelInstance.Font.Name = "Courier New"
        labelInstance.Font.Size = 8
        
        '---------------------
        ' 2.4 Setup checkStep
        '---------------------
        For j = 1 To PROPERTIES_MaxStepCount
        
            checkboxName = "checkStep_" & Format(i, "00") & "_" & Format(j, "00")
            Set checkboxInstance = Me.Controls.Add("Forms.Label.1", checkboxName, True)
            
            checkboxInstance.Width = PROPERTIES_StepsWidth
            checkboxInstance.Height = PROPERTIES_RowHeight
            checkboxInstance.Left = LABEL_ScheduleBackground(i).Left + LABEL_ScheduleBackground(i).Width + Padding + (checkboxInstance.Width + Padding) * (j - 1)
            checkboxInstance.Top = LABEL_ScheduleBackground(i).Top
            
            checkboxInstance.SpecialEffect = fmButtonEffectFlat
            checkboxInstance.BackColor = RGB(250, 250, 250)
            checkboxInstance.Font.Name = "Courier New"
            checkboxInstance.Font.Size = 8
            checkboxInstance.Caption = ""
            checkboxInstance.WordWrap = False
            
            Set checkStep(i, j) = New Class1
            Set checkStep(i, j).checkbox = checkboxInstance
            Set checkStep(i, j).Range = ThisWorkbook.Sheets("Switches").Range("B2").Offset(i - 1, j - 1)
            checkStep(i, j).Row = i
                    
        
        Next
        
    Next
    
End Sub

Private Sub Inkout(ByVal InkoutMapDirectory As String, ByVal Schedule As String, ByVal ScheduleIndex As Integer)

    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    '-------------------------------
    ' 1. Get the needed directories
    '-------------------------------
    PanelMapDirectory = Me.txtPanelMapDirectory
    MergeMapDirectory = Me.txtMergeMapDirectory
    
    '-----------------------------------------------
    ' 2. Create Inkout Folders in MergeMapDirectory
    '-----------------------------------------------
    If Dir(MergeMapDirectory, vbDirectory) = "" Then MkDir MergeMapDirectory
    If Dir(MergeMapDirectory & "\" & Schedule, vbDirectory) = "" Then MkDir (MergeMapDirectory & "\" & Schedule)
    If Dir(MergeMapDirectory & "\" & Schedule & "\Merge Map", vbDirectory) = "" Then MkDir (MergeMapDirectory & "\" & Schedule & "\Merge Map")
    'If Dir(MergeMapDirectory & "\Inkout Map", vbDirectory) = "" Then MkDir (MergeMapDirectory & "\Inkout Map")
    'If Dir(MergeMapDirectory & "\Panel Map", vbDirectory) = "" Then MkDir (MergeMapDirectory & "\Panel Map")
    
    
    InkoutMapList = Module1.GetMapList(InkoutMapDirectory)
    'PanelMapList = GetMapList(PanelMapDirectory & "\" & Schedule & "*")
    
    
    
    
    
    
    For Each InkoutMap In InkoutMapList
        
        '(4) Get InkoutMap from Bumping2
        FileToCopy = InkoutMapDirectory & "\" & InkoutMap
        SaveFileAs = MergeMapDirectory & "\" & Schedule & "\" & InkoutMap
        
        'Need to program if already has
        ThisWorkbook.Sheets(1).Range("A16").Value = FileToCopy
        ThisWorkbook.Sheets(1).Range("A17").Value = SaveFileAs
        fso.CopyFile FileToCopy, SaveFileAs
        
        '(5) Convert Defect Code
        Module1.ConvertDefectCode SaveFileAs
        
        InkoutMapID = Module1.GetWaferID(InkoutMap)
        PanelMapID = Dir(PanelMapDirectory & "\" & Schedule)
    
        'PanelMapDirectory =
        '(6) Sort through each PanelMap
        'For Each PanelMap In PanelMapList
        
        '    InkoutMapID = GetWaferID(InkoutMap)
        '    PanelMapID = GetWaferID(PanelMap)
            
        '    If InkoutMapID = PanelMapID Then
                
        PanelMap = Dir(PanelMapDirectory & "\" & Schedule & "-" & Format(InkoutMapID, "00") & "*")
        If PanelMap = "" Then Me.Controls("lblRemarks_" & Format(ScheduleIndex, "00")).Caption = "PanelMap not found"
        
        FileToCopy = PanelMapDirectory & "\" & PanelMap
        SaveFileAs = MergeMapDirectory & "\" & Schedule & "\" & PanelMap
        fso.CopyFile FileToCopy, SaveFileAs
                
        MergeMapContent = Module1.MergeMap(MergeMapDirectory & "\" & Schedule & "\" & PanelMap, MergeMapDirectory & "\" & Schedule & "\" & InkoutMap)
        MsgBox MergeMapContent
        filePath = MergeMapDirectory & "\" & Schedule & "\Merge Map\" & PanelMap
        
        'MergeMapContent = MergeMap("C:\Users\Sean\OneDrive\Desktop\Onyx\PanelMap\" & PanelMap, MergeMapDirectory & "\Inkout Map\" & InkoutMap)
        '        filePath = MergeMapDirectory & "\Merge Map\" & PanelMap
                
        '        If Dir(MergeMapDirectory & "\Merge Map", vbDirectory) = "" Then
        '            MkDir MergeMapDirectory & "\MergeMap"
        '        End If
                
        fileNum = FreeFile
        Open filePath For Output As #fileNum
        Print #fileNum, MergeMapContent
        Close #fileNum
                
        '        Exit For
        '    End If
        'Next
            

    Next
End Sub




Private Sub btnInkout_Click()
    
    Dim ScheduleCount As Integer
    ScheduleCount = ThisWorkbook.Sheets("Switches").Range("A" & Rows.Count).End(xlUp).Row - 1
    
    
    Dim InkoutSchedules As String
    
    For i = 1 To ScheduleCount
        
        Schedule = ThisWorkbook.Sheets("Switches").Range("A2").Offset(i - 1, 0).Value2
        ScheduleMaxStepCount = ThisWorkbook.Sheets("Switches").Cells(1 + i, Columns.Count).End(xlToLeft).Column - 1
        
        For j = 1 To ScheduleMaxStepCount
        
            
            NeedInkout = ThisWorkbook.Sheets("Switches").Range("B2").Offset(i - 1, j - 1).Value
                
            If NeedInkout Then
            
                CumulativeCount = ThisWorkbook.Sheets("Subfolders").Range("E3").Offset(i - 1, 0).Value
                InkoutMapDirectory = ThisWorkbook.Sheets("Subfolders").Range("G3").Offset(CumulativeCount + j - 1, 0).Value
                Module1.Inkout Schedule, InkoutMapDirectory

            End If
            
        Next
    Next
    
    
    MsgBox "Done Inkout"


End Sub










Private Sub txtInkoutSchedules_Change()
    
    '------------------------------------
    ' 1. Cleans txtInkoutSchedules Input
    '------------------------------------
    '--------------------------------------
    ' 1.1 Capitalize and delete whitespace
    '--------------------------------------
    txtInkoutScheduleInput = txtInkoutSchedules.Value
    txtInkoutScheduleInput = Replace(UCase(txtInkoutScheduleInput), " ", "")
    
    '----------------------------------------------
    ' 1.2 Adds inputs with 10 characters long only
    '----------------------------------------------
    Dim ScheduleList(0 To 20) As Variant, ScheduleCount As Integer
    ScheduleCount = 0
    For Each Schedule In Split(txtInkoutSchedules.Value, vbNewLine)
        If Len(Schedule) = 10 Then
            
            ScheduleList(ScheduleCount) = Schedule
            ScheduleCount = ScheduleCount + 1
        End If
    Next
    
    '--------------------------------
    ' 2. Retrieve program properties
    '--------------------------------
    PROPERTIES_MaxScheduleCount = ThisWorkbook.Sheets("Settings").Range("B5").Value2
    PROPERTIES_MaxStepCount = ThisWorkbook.Sheets("Settings").Range("B6").Value2
    'IN/6440/AEI/6730/6630/6733/6688/6905
    
    
    '------------------------------------------------------------------------------------------------------
    ' 2. Reset/clear "switches"; these switches is used to check which steps the user has chosen to inkout
    '------------------------------------------------------------------------------------------------------
    ThisWorkbook.Sheets("Switches").UsedRange.Value = ""
    ThisWorkbook.Sheets("Subfolders").Range("B3:G" & Rows.Count).Clear
    
    For i = 1 To PROPERTIES_MaxScheduleCount
    
        Me.Controls("lblScheduleBackground_" & Format(i, "00")).BackColor = RGB(250, 250, 250)
        Me.Controls("lblSchedule_" & Format(i, "00")).Caption = ""
        
        For j = 1 To PROPERTIES_MaxStepCount
            
            Me.Controls("checkStep_" & Format(i, "00") & "_" & Format(j, "00")).BackColor = RGB(250, 250, 250)
            Me.Controls("checkStep_" & Format(i, "00") & "_" & Format(j, "00")).Caption = ""
        Next
    Next
        
    '------------------------------------------------------
    ' For each schedule, get a list of all available steps
    '------------------------------------------------------
    Dim Summary() As Variant
    ReDim Summary(ScheduleCount, 4)
    Dim SubfolderCount As Integer
    Dim CumulativeCount As Integer
    CumulativeCount = 0
    For i = 0 To ScheduleCount - 1
        
        Schedule = ScheduleList(i)
        Me.Controls("lblSchedule_" & Format(i + 1, "00")).Caption = Schedule
        Me.Controls("lblScheduleBackground_" & Format(i + 1, "00")).BackColor = RGB(242, 242, 242)
        
        InkoutMapScheduleDigits = Left(Schedule, 2)
        
        '-----------------------------------------------------
        ' 1. Get Subfolders with Maps from the root directory
        '    Also loops through two years/workweek
        '-----------------------------------------------------
        LastRow_1 = ThisWorkbook.Sheets("Subfolders").Range("F" & Rows.Count).End(xlUp).Row
        MotherLotID = ""
        For j = 0 To 1
            
            InkoutMapWorkWeek = Right(Year(Now) - j, 2)
            InkoutMapDirectory = Me.txtInkoutMapDirectory.Value & "\W" & InkoutMapWorkWeek & InkoutMapScheduleDigits
            'MsgBox InkoutMapDirectory & "\" & Schedule
            If Not IsEmpty(Module1.GetMotherLotID(InkoutMapDirectory & "\" & Schedule)) Then
              
                For Each Map In Module1.GetMotherLotID(InkoutMapDirectory & "\" & Schedule)
                    If InStr(1, Map, "-AEI.", vbTextCompare) > 0 Then
                        MotherLotID = Split(Map, "-")(0)
                        Exit For
                    End If
             '       MsgBox Map
                    
                Next
            End If
            Module1.RunFolderScan InkoutMapDirectory & "\" & Schedule
        Next
        LastRow_2 = ThisWorkbook.Sheets("Subfolders").Range("F" & Rows.Count).End(xlUp).Row
        SubfolderCount = LastRow_2 - LastRow_1
        
        
        'If i > 0 Then CumulativeCount = SubfolderCount + Summary(i - 1, 2)
        'Summary(i, 3) = CumulativeCount
        'Summary(i, 3) = SubfolderCount + IIf(i > 0, Summary(i - 1, 2), 0)
        '--------------------------------------------
        ' If step cannot be found in Bumping2 folder
        '--------------------------------------------
        
        Me.Controls("lblScheduleBackground_" & Format(i + 1, "00")).Visible = True
        
        For j = 1 To SubfolderCount
            'MsgBox CumulativeCount + j
            ThisWorkbook.Sheets("Switches").Range("B2").Offset(i, j - 1).Value = False
            StepName = ThisWorkbook.Sheets("Subfolders").Range("F2").Offset(CumulativeCount + j, 0).Value
            Me.Controls("checkStep_" & Format(i + 1, "00") & "_" & Format(j, "00")).BackColor = RGB(242, 242, 242) 'Light Blue
            Me.Controls("checkStep_" & Format(i + 1, "00") & "_" & Format(j, "00")).Caption = Replace(StepName, "\", "\" & vbNewLine)
            Me.Controls("checkStep_" & Format(i + 1, "00") & "_" & Format(j, "00")).Visible = True
            StepFolderName = ThisWorkbook.Sheets("Subfolders").Range("F" & 2 + j).Value
            
        Next
        Summary(i, 0) = Schedule
        If Int(Right(Schedule, 2)) <= 2 Then
            MotherLotID = Schedule
        ElseIf MotherLotID = "" Then
            Me.Controls("lblRemarks_" & Format(i + 1, "00")).Caption = "No Mother Lot ID"
        End If
        Summary(i, 1) = MotherLotID
        Summary(i, 2) = SubfolderCount
        Summary(i, 3) = CumulativeCount
        CumulativeCount = CumulativeCount + SubfolderCount
        
SkipLot:
    Next
    ThisWorkbook.Sheets("Subfolders").Range("B3:E" & 2 + ScheduleCount).Value = Summary

    
 
   
    '----------------------------------------------
    ' Update each control to reflect each schedule
    '----------------------------------------------
    Dim Schedules() As String
    ReDim Schedules(0 To ScheduleCount, 1)
    For i = 1 To ScheduleCount + 1
        Schedules(i - 1, 0) = ScheduleList(i - 1)
        
    Next
    
    ThisWorkbook.Sheets("Switches").Range("A2:A" & 1 + ScheduleCount).Value = Schedules
    
    
    
End Sub


