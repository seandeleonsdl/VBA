Private Sub UserForm_Initialize()
            
    '------------------------
    ' 1.) Program properties
    '------------------------
    Dim wsSettings As Worksheet
    Set wsSettings = ThisWorkbook.Sheets("Settings")
    PROPERTIES_PanelMapDirectory = wsSettings.Range("B2").Value2
    PROPERTIES_InkoutMapDirectory = wsSettings.Range("B3").Value2
    PROPERTIES_MergeMapDirectory = wsSettings.Range("B4").Value2
    PROPERTIES_MaxScheduleCount = wsSettings.Range("B5").Value2
    PROPERTIES_MaxStepCount = wsSettings.Range("B6").Value2
    
    PROPERTIES_StepsWidth = 30
    PROPERTIES_StepsHeight = 18
    
    
    ReDim checkStep(1 To PROPERTIES_MaxScheduleCount, 1 To PROPERTIES_MaxStepCount)
    ReDim LABEL_Schedule(1 To PROPERTIES_MaxScheduleCount) As Object
    ReDim LABEL_ScheduleBackground(1 To PROPERTIES_MaxScheduleCount) As Object
    
    subSetCSSStyling
    
    Me.txtPanelMapDirectory.Value = PROPERTIES_PanelMapDirectory
    Me.txtInkoutMapDirectory.Value = PROPERTIES_InkoutMapDirectory
    Me.txtMergeMapDirectory.Value = PROPERTIES_MergeMapDirectory
    
    '--------------------------------
    ' 2.) Set-up userform aesthetics
    '--------------------------------
    For i = 1 To PROPERTIES_MaxScheduleCount
        
        '--------------------
        ' 1. Setup Schedules
        '--------------------
        
        Set LABEL_ScheduleBackground(i) = Me.Controls.Add("Forms.Label.1", "lblScheduleBackground_" & Format(i, "00"), True)
        LABEL_ScheduleBackground(i).Width = 65
        LABEL_ScheduleBackground(i).Height = 18
        LABEL_ScheduleBackground(i).Left = Me.lblScheduleBackground.Left
        LABEL_ScheduleBackground(i).Top = Me.lblScheduleBackground.Top + Me.lblScheduleBackground.Height + 6 + 24 * (i - 1)
        LABEL_ScheduleBackground(i).BackColor = RGB(240, 240, 240)
        LABEL_ScheduleBackground(i).Visible = False
        
        Set LABEL_Schedule(i) = Me.Controls.Add("Forms.Label.1", "lblSchedule_" & Format(i, "00"), True)
        LABEL_Schedule(i).Width = 65
        LABEL_Schedule(i).Left = Me.lblScheduleBackground.Left + 6
        LABEL_Schedule(i).Top = Me.lblScheduleBackground.Top + Me.lblScheduleBackground.Height + 6 + 4 + 24 * (i - 1)
        LABEL_Schedule(i).BackStyle = fmBackStyleTransparent
        LABEL_Schedule(i).Caption = ""
        LABEL_Schedule(i).Font.Name = "Courier New"
        LABEL_Schedule(i).Font.Size = 8
        
        '----------------
        ' Setup Remarks
        '---------------
        Set labelInstance = Me.Controls.Add("Forms.Label.1", "lblRemarks_" & Format(i, "00"), True)
        labelInstance.Left = LABEL_ScheduleBackground(i).Left + LABEL_ScheduleBackground(i).Width + 6 + (PROPERTIES_StepsWidth + 6) * (PROPERTIES_MaxStepCount)
        labelInstance.Top = LABEL_ScheduleBackground(i).Top
        labelInstance.Width = lblRemarks.Width
        labelInstance.BackColor = RGB(240, 240, 240)
        labelInstance.Font.Name = "Courier New"
        labelInstance.Font.Size = 8
        
        
        For j = 1 To PROPERTIES_MaxStepCount
        
            checkboxName = "checkStep_" & Format(i, "00") & "_" & Format(j, "00")
            Set checkboxInstance = Me.Controls.Add("Forms.Label.1", checkboxName, True)
            
            '----------------
            ' a.) Dimensions
            '----------------
            checkboxInstance.Width = PROPERTIES_StepsWidth
            checkboxInstance.Height = PROPERTIES_StepsHeight
            checkboxInstance.Left = LABEL_ScheduleBackground(i).Left + LABEL_ScheduleBackground(i).Width + 6 + (checkboxInstance.Width + 6) * (j - 1)
            checkboxInstance.Top = LABEL_ScheduleBackground(i).Top
            
            '-------------
            ' c.) Styling
            '-------------
            checkboxInstance.SpecialEffect = fmButtonEffectFlat
            checkboxInstance.BackColor = RGB(240, 240, 240)
            checkboxInstance.ForeColor = RGB(255, 255, 255)
            checkboxInstance.Font.Name = "Courier New"
            checkboxInstance.Font.Size = 8
            checkboxInstance.Font.Bold = True
            checkboxInstance.Caption = ""
            If i > 1 Then checkboxInstance.Visible = False
            
            Set checkStep(i, j) = New Class1
            Set checkStep(i, j).checkbox = checkboxInstance
            Set checkStep(i, j).Range = ThisWorkbook.Sheets(2).Range("B2").Offset(i - 1, j - 1)
            checkStep(i, j).Row = i
            
          
            
            'toggleYes = Me.Controls.Add("Forms.Label.1", checkboxName, True)
            
        
        Next
        
    Next
    
End Sub

Private Sub Inkout(ByVal InkoutMapDirectory As String, ByVal Schedule As String, ByVal ScheduleIndex As Integer)

    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    '-------------------------------
    ' 1. Get the needed directories
    '-------------------------------
    PanelMapDirectory = Me.txtPanelMapDirectory
    MergeMapDirectory = Me.txtMergeMapDirectory
    
    '-----------------------------------------------
    ' 2. Create Inkout Folders in MergeMapDirectory
    '-----------------------------------------------
    If Dir(MergeMapDirectory, vbDirectory) = "" Then MkDir MergeMapDirectory
    If Dir(MergeMapDirectory & "\" & Schedule, vbDirectory) = "" Then MkDir (MergeMapDirectory & "\" & Schedule)
    If Dir(MergeMapDirectory & "\" & Schedule & "\Merge Map", vbDirectory) = "" Then MkDir (MergeMapDirectory & "\" & Schedule & "\Merge Map")
    'If Dir(MergeMapDirectory & "\Inkout Map", vbDirectory) = "" Then MkDir (MergeMapDirectory & "\Inkout Map")
    'If Dir(MergeMapDirectory & "\Panel Map", vbDirectory) = "" Then MkDir (MergeMapDirectory & "\Panel Map")
    
    
    InkoutMapList = Module1.GetMapList(InkoutMapDirectory)
    'PanelMapList = GetMapList(PanelMapDirectory & "\" & Schedule & "*")
    
    
    
    
    
    
    For Each InkoutMap In InkoutMapList
        
        '(4) Get InkoutMap from Bumping2
        FileToCopy = InkoutMapDirectory & "\" & InkoutMap
        SaveFileAs = MergeMapDirectory & "\" & Schedule & "\" & InkoutMap
        
        'Need to program if already has
        ThisWorkbook.Sheets(1).Range("A16").Value = FileToCopy
        ThisWorkbook.Sheets(1).Range("A17").Value = SaveFileAs
        fso.CopyFile FileToCopy, SaveFileAs
        
        '(5) Convert Defect Code
        Module1.ConvertDefectCode SaveFileAs
        
        InkoutMapID = Module1.GetWaferID(InkoutMap)
        PanelMapID = Dir(PanelMapDirectory & "\" & Schedule)
    
        'PanelMapDirectory =
        '(6) Sort through each PanelMap
        'For Each PanelMap In PanelMapList
        
        '    InkoutMapID = GetWaferID(InkoutMap)
        '    PanelMapID = GetWaferID(PanelMap)
            
        '    If InkoutMapID = PanelMapID Then
                
        PanelMap = Dir(PanelMapDirectory & "\" & Schedule & "-" & Format(InkoutMapID, "00") & "*")
        If PanelMap = "" Then Me.Controls("lblRemarks_" & Format(ScheduleIndex, "00")).Caption = "PanelMap not found"
        
        FileToCopy = PanelMapDirectory & "\" & PanelMap
        SaveFileAs = MergeMapDirectory & "\" & Schedule & "\" & PanelMap
        fso.CopyFile FileToCopy, SaveFileAs
                
        MergeMapContent = Module1.MergeMap(MergeMapDirectory & "\" & Schedule & "\" & PanelMap, MergeMapDirectory & "\" & Schedule & "\" & InkoutMap)
        MsgBox MergeMapContent
        filePath = MergeMapDirectory & "\" & Schedule & "\Merge Map\" & PanelMap
        
        'MergeMapContent = MergeMap("C:\Users\Sean\OneDrive\Desktop\Onyx\PanelMap\" & PanelMap, MergeMapDirectory & "\Inkout Map\" & InkoutMap)
        '        filePath = MergeMapDirectory & "\Merge Map\" & PanelMap
                
        '        If Dir(MergeMapDirectory & "\Merge Map", vbDirectory) = "" Then
        '            MkDir MergeMapDirectory & "\MergeMap"
        '        End If
                
        fileNum = FreeFile
        Open filePath For Output As #fileNum
        Print #fileNum, MergeMapContent
        Close #fileNum
                
        '        Exit For
        '    End If
        'Next
            

    Next
End Sub




Private Sub btnInkout_Click()
    
