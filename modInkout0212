Public Function AnalyzeMapText( _
        ByVal WaferMap As String, _
        ByVal CommonDefects As Object) As MapStats

    Dim lines() As String
    Dim tokens() As String
    Dim line As String
    Dim token As String
    Dim i As Long, j As Long
    Dim stats As MapStats
    Set stats = New MapStats
    Set stats.DefectMap = CreateObject("Scripting.Dictionary")
    
    
    '---------------------------
    ' 1. Split WaferMap by line
    '---------------------------
    lines = Split(WaferMap, vbCrLf)
    minGoodCol = 5000
    RowIndex = 0
    For i = LBound(lines) To UBound(lines)
    
        line = lines(i)
    
        If UCase(Left$(line, 8)) = "ROWDATA:" Then
            RowIndex = RowIndex + 1
            tokens = Split(Mid$(line, 9), " ")
    
            For j = LBound(tokens) To UBound(tokens)
                If tokens(j) = "000" Then
                    colIndex = j
                    If colIndex < minGoodCol Then minGoodCol = colIndex
                    If RowIndex > maxGoodRow Then maxGoodRow = RowIndex
                End If
            Next j
        End If
    Next i
    
    stats.OriginCol = minGoodCol
    stats.OriginRow = maxGoodRow
    'MsgBox "mingood col: " & minGoodCol
    'MsgBox "maxGoodRow col: " & maxGoodRow
    '---------------------------
    ' 2. Loop through each line
    '---------------------------
    RowIndex = 0
    For i = LBound(lines) To UBound(lines)
        
        line = lines(i)

        '-------------------------------------------------------------
        ' 2.1 Starts reading the line only if it begins with RowData:
        '-------------------------------------------------------------
        

        If UCase(Left$(line, 8)) = "ROWDATA:" Then
            RowIndex = RowIndex + 1
            '------------------------------------------
            ' 2.2 Analyze the line only after RowData:
            '------------------------------------------
            line = Mid$(line, 9)
            
            '-------------------------------------------------------------------
            ' 2.3 Counts the number of whitespaces by removing all white spaces
            '     and counting the length of line
            '-------------------------------------------------------------------
            stats.SpaceCount = stats.SpaceCount + _
                (Len(line) - Len(Replace$(line, " ", "")))
            
            '----------------------------------------
            ' 2.4 Delimits the tokens by whitespaces
            '----------------------------------------
            tokens = Split(line, " ")
            'MsgBox "Origin Col is " & stats.OriginCol
            For j = LBound(tokens) To UBound(tokens)
                colIndex = j
                token = tokens(j)
                
                Select Case True

                    Case token = "___"
                        
                        stats.UnderscoreCount = stats.UnderscoreCount + 1
                
                    ' Good die
                    Case token = "000"
                        
                        stats.DPW = stats.DPW + 1
                        ' origin logic already handled in first pass
                        ' DO NOT store location
                
                    ' Numeric defect die
                    Case Len(token) = 3 And token >= "000" And token <= "999"
                        
                        stats.DPW = stats.DPW + 1
                        
                        If Not CommonDefects.Exists(token) Then
                            stats.UncommonCount = stats.UncommonCount + 1
                            stats.HasUncommonDefect = True
                        End If
                
                        ' -------- STORE DEFECT LOCATION --------
                        
                        If token <> "000" Then
                            Dim loc As DieLocation
                            'loc.X = colIndex - stats.OriginCol
                            'MsgBox "colIndex is " & colIndex
                            X = colIndex - stats.OriginCol
                            'loc.Y = stats.OriginRow - RowIndex
                            'MsgBox "RowIndex is " & RowIndex
                            Y = stats.OriginRow - RowIndex
                            
                            If Not stats.DefectMap.Exists(token) Then
                                Dim c As Object
                                Set c = New Collection
                                stats.DefectMap.Add token, c
                            End If
                            'MsgBox "(" & CStr(X) & "," & CStr(Y) & ")"
                            stats.DefectMap(token).Add "(" & CStr(X) & "," & CStr(Y) & ")"
                        End If
                
                    ' Other defect codes (e.g. F15, A07)
                    Case Else
                        
                        stats.UncommonCount = stats.UncommonCount + 1
                        stats.HasUncommonDefect = True
                
                        ' -------- STORE DEFECT LOCATION --------
                        'Dim loc2 As DieLocation
                        'loc2.X = colIndex - stats.OriginCol
                        X = colIndex - stats.OriginCol
                        'loc2.Y = stats.OriginRow - RowIndex
                        Y = stats.OriginRow - RowIndex
                        If Not stats.DefectMap.Exists(token) Then
                            Dim c2 As Object
                            Set c2 = New Collection
                            'stats.DefectMap.Add token, c2
                        End If
                
                        'stats.DefectMap(token).Add CStr(X) & "," & CStr(Y)
                End Select
                
            Next j
        End If
    Next i
    
    Set AnalyzeMapText = stats
    
End Function


Public Function CountString(ByVal mainString As String, ByVal subString As String) As Long
    Dim position As Long
    Dim count As Long
    
    count = 0
    position = InStr(1, mainString, "RowData:", vbTextCompare)
    position = InStr(position, mainString, subString, vbTextCompare)
    
    Do While position > 0
        count = count + 1
        position = InStr(position + 1, mainString, subString, vbTextCompare)
    Loop
    
    CountString = count
    
    
End Function


