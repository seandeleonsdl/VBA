Public Sub subSetInkoutScheduleFolder(ByVal Index_Schedule As Integer, Index_Step As Integer)
    
    '-----------------------------------------------------------
    ' 1. Obtain InkoutFolder Object Inkout Schedule Inkout_Step
    '-----------------------------------------------------------
    Color_LightGray = RGB(240, 240, 240)
    Color_Red = RGB(255, 0, 0)
    Color_White = RGB(255, 255, 255)
    
    '------------------------------------------------------------------
    ' 1. Check if the InkoutFolder is available for the InkoutSchedule
    '------------------------------------------------------------------
    InkoutSchedule = ThisWorkbook.Sheets("Switches").Cells(1 + Index_Schedule, 1).Value2
    InkoutSchedule_FolderCount = ThisWorkbook.Sheets("Switches").Cells(1 + Index_Schedule, Columns.count).End(xlToLeft).Column - 1
    
    If Index_Step > InkoutSchedule_FolderCount Then
        MsgBox "The Inkout Folder (" & Index_Step & ") is not available for Inkout Schedule " & InkoutSchedule
        Exit Sub
    End If
    
    '------------------------------------------------------------------
    ' 2. Switch False all other InkoutFolder except InkoutFolder_Index
    '------------------------------------------------------------------
    Dim InkoutFolder_Range As Range
    For j = 1 To InkoutSchedule_FolderCount
        
        If j <> Index_Step Then
            Set InkoutFolder_Range = ThisWorkbook.Sheets("Switches").Range("B2").Offset(Index_Schedule - 1, j - 1)
            InkoutFolder_Range.Value = False
            Module1.subSetUI_False InkoutSchedule_Index, j
        End If
    
    Next
    
    '------------------------------------------------------------------------------------
    ' 3. If InkoutFolder_Index is already True, change value & UI to False then Exit Sub
    '------------------------------------------------------------------------------------
    Set InkoutFolder_Range = ThisWorkbook.Sheets("Switches").Range("B2").Offset(Index_Schedule - 1, Index_Step - 1)
    If InkoutFolder_Range.Value2 = True Then
        
        InkoutFolder_Range.Value = False
        Module1.subSetUI_False InkoutSchedule_Index, InkoutFolder_Index
        Exit Sub
        
    End If

    
    InkoutSchedule_MotherLotID = ThisWorkbook.Sheets("Subfolders").Range("C2").Offset(Index_Schedule, 0).Value
    
    
    '--------------------------------
    ' ERROR CASE 1: No Mother Lot ID
    '--------------------------------
    If InkoutSchedule_MotherLotID = "" Then
        Module4.subSetUI_Error InkoutSchedule_Index, InkoutFolder_Index, "No Mother Lot ID found; please manual ink-out."
        
        With formAutoInkout.Controls("lblRemarks_" & Format(Index_Schedule, "00"))
            .Caption = "No Mother Lot ID found; please manual ink-out."
            .BackColor = Color_Red
            .ForeColor = Color_White
        End With
        
        Exit Sub
    End If
    
    CumulativeCount = ThisWorkbook.Sheets("Subfolders").Range("E2").Offset(Index_Schedule, 0).Value
    InkoutMapDirectory = ThisWorkbook.Sheets("Subfolders").Range("G3").Offset(CumulativeCount + Index_Step - 1, 0).Value
    InkoutMapList = Module1.GetMapList(Schedule, InkoutMapDirectory)
    
    '----------------------------------
    ' ERROR CASE 2: No map in Bumping2
    '----------------------------------
    If IsEmpty(InkoutMapList) Then
        formAutoInkout.Controls("lblRemarks_" & Format(Index_Schedule, "00")).Caption = "No maps found in Bumping2 Ink-out Folder."
        Exit Sub
    End If
    
    Dim Remarks(1 To 13) As String, path(1 To 13)
    Dim ImpactWaferCount As Integer
    
    
    For Each Map In InkoutMapList
        
        filePath = InkoutMapDirectory & "\" & Map
        
        InkoutMapWaferID = Module1.GetWaferID(filePath)
        
        DefectCount = Module1.CountF30(filePath)
        
        If DefectCount > 0 Then
            ImpactWaferCount = ImpactWaferCount + 1
            
            '--------------------------------------------------
            ' ERROR CASE 3: 1 Wafer with multiple ink-out maps
            '--------------------------------------------------
            If Remarks(InkoutMapWaferID) <> "" Then
                formAutoInkout.Controls("lblRemarks_" & Format(Index_Schedule, "00")).Caption = "2 maps for 1 wafer detected; please confirm."
                Exit Sub
            End If
            Remarks(InkoutMapWaferID) = "S" & InkoutMapWaferID & "-" & DefectCount & "ea"
            path(InkoutMapWaferID) = filePath
            
        End If
    Next

    '-------------------------
    ' CASE 3: No F30 detected
    '-------------------------
    If ImpactWaferCount = 0 Then
        RemarksString = "No F30 detected"
        formAutoInkout.Controls("lblRemarks_" & Format(Index_Schedule, "00")).Caption = RemarksString
        Exit Sub
    End If
    
    
    Dim ImpactRemarks() As String, ImpactPath() As String
    ReDim ImpactRemarks(0 To ImpactWaferCount - 1)
    ReDim ImpactPath(0 To ImpactWaferCount - 1)
    Dim count As Integer
    count = 0
    Dim Dictionary() As Variant
    ReDim Dictionary(1 To ImpactWaferCount)
    
    'InitializeDictionaries (ImpactWaferCount)
    
    For i = 1 To 13
        Remark = Remarks(i)
        If Remark <> "" Then
            
            ImpactRemarks(count) = Remark
            ImpactPath(count) = path(i)
            count = count + 1
            'Set Dictionary(count) = Module1.CountDefectCodes(path(i))
            
        End If
    
    Next
    
    
    
    RemarksString = Join(ImpactRemarks, ",")
    
    instanceSwitch.Value = True
    Schedule = ThisWorkbook.Sheets(2).Range("A2").Offset(Index_Schedule - 1, 0).Value
    formAutoInkout.Controls("lblRemarks_" & Format(Index_Schedule, "00")).Caption = RemarksString
    
    '-----------------
    ' Ongoing testing
    '-----------------
    'formChangeCode.loaddict Dictionary
    'formChangeCode.Show

End Sub


Public Function AppendToTextFile(ByVal TextToAppend As String) As Boolean
    
    filePath = "\\10.10.20.70\Bumping5\Other\Sean\Auto Inkout Log.txt"
    Dim fileNum As Integer
    
    On Error GoTo ErrHandler
    
    fileNum = FreeFile
    Open filePath For Append As #fileNum
    Print #fileNum, TextToAppend
    Close #fileNum
    
    AppendToTextFile = True
    Exit Function

ErrHandler:
    AppendToTextFile = False
    If fileNum > 0 Then Close #fileNum
End Function

