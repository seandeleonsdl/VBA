Public Function CountF30(ByVal Filename As String)
        
    '-----------------
    ' Get Directories
    '-----------------

    fileNum = FreeFile
    Open Filename For Input As #fileNum
    fileContent = ""
        
    Do Until EOF(fileNum)
        Line Input #fileNum, LineInstance
        fileContent = fileContent & vbNewLine & LineInstance
    Loop
    Close #fileNum
        
    DefectCount = CountString(fileContent, "019") + CountString(fileContent, "020") + CountString(fileContent, "021") + CountString(fileContent, "030")
    CountF30 = DefectCount
        
End Function

Public Function CountString(ByVal mainString As String, ByVal subString As String) As Long
    Dim position As Long
    Dim Count As Long
    
    Count = 0
    position = InStr(1, mainString, subString, vbTextCompare)
    
    Do While position > 0
        Count = Count + 1
        position = InStr(position + 1, mainString, subString, vbTextCompare)
    Loop
    
    CountString = Count
    
    
End Function



Public Sub Inkout(ByVal Schedule As String, ByVal MotherLotID As String, ByVal Directory As String)

    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    '-----------------
    ' Get Directories
    '-----------------
    '(1) Get Directories
    'ScheduleMaxStepCount = ThisWorkbook.Sheets("Switches").Cells(1 + x, Columns.Count).End(xlToLeft).Column - 1
    'InkoutMapDirectory =WorkWeek = Right(Year(Now), 2)
    
    
    
    PanelMapDirectory = ThisWorkbook.Sheets("Settings").Range("B2").Value
    MergeMapDirectory = ThisWorkbook.Sheets("Settings").Range("B4").Value
    
    '(2) Create Inkout Folders in MergeMapDirectory
    If Dir(MergeMapDirectory, vbDirectory) = "" Then MkDir MergeMapDirectory
    If Dir(MergeMapDirectory & "\Inkout Map", vbDirectory) = "" Then MkDir (MergeMapDirectory & "\Inkout Map")
    If Dir(MergeMapDirectory & "\Panel Map", vbDirectory) = "" Then MkDir (MergeMapDirectory & "\Panel Map")
    If Dir(MergeMapDirectory & "\Merge Map", vbDirectory) = "" Then MkDir (MergeMapDirectory & "\Merge Map")
    
    
    '(3) Get Map List from Bumping2 and PanelMap
    
    MapList = GetMapList(Directory)
    PanelMapList = GetMapList(PanelMapDirectory & "\" & Schedule & "*")
    
    For Each InkoutMap In MapList
           
        '(4) Get InkoutMap from Bumping2
        FileToCopy = Directory & "\" & InkoutMap
        SaveFileAs = MergeMapDirectory & "\Inkout Map\" & InkoutMap
        fso.CopyFile FileToCopy, SaveFileAs
        
        '(5) Convert Defect Code
        ConvertDefectCode SaveFileAs
        
        '(6) Sort through each PanelMap
        For Each PanelMap In PanelMapList
        
            InkoutMapID = GetWaferID(InkoutMap)
            PanelMapID = GetWaferID(PanelMap)
            
            If InkoutMapID = PanelMapID Then
                
                FileToCopy = PanelMapDirectory & "\" & PanelMap
                SaveFileAs = MergeMapDirectory & "\Panel Map\" & PanelMap
                fso.CopyFile FileToCopy, SaveFileAs
                
                MergeMapContent = MergeMap(PanelMapDirectory & "\" & PanelMap, MergeMapDirectory & "\Inkout Map\" & InkoutMap)
                filePath = MergeMapDirectory & "\Merge Map\" & PanelMap
                
                If Dir(MergeMapDirectory & "\Merge Map", vbDirectory) = "" Then
                    MkDir MergeMapDirectory & "\MergeMap"
                End If
                
                fileNum = FreeFile
                Open filePath For Output As #fileNum
                Print #fileNum, MergeMapContent
                Close #fileNum
                
                Exit For
            End If
        Next
            
    Next



End Sub

Public Function GetWaferID(ByVal Filename As String) As Integer

    Filename = Replace(Filename, ".txt", "")
    Filename = Replace(Filename, ".", "-")
    Filename = Split(Filename, "-")(UBound(Split(Filename, "-")))
    Filename = Replace(Filename, "S", "")
    Filename = Left(Filename, 2)
    
    GetWaferID = Int(Filename)

End Function

Public Function MergeMap(ByVal PanelMapFilename As String, InkoutMapFilename As String) As String
    
    filePath = Filename
    fileNum = FreeFile
    
    
    '-----------------------
    ' Get Panel Map Content
    '-----------------------
    MsgBox PanelMapFilename
    Open PanelMapFilename For Input As #fileNum
    
    Do Until EOF(fileNum)
        Line Input #fileNum, LineInstance
        PanelMapFileContent = PanelMapFileContent & vbNewLine & LineInstance
    Loop
    Close #fileNum
    PanelMapFileContent = Right(PanelMapFileContent, Len(PanelMapFileContent) - 2)
    
    '------------------------
    ' Get Inkout Map Content
    '------------------------
    
    Open InkoutMapFilename For Input As #fileNum
    
    Do Until EOF(fileNum)
        Line Input #fileNum, LineInstance
        InkoutMapFileContent = InkoutMapFileContent & vbNewLine & LineInstance
    Loop
    Close #fileNum
    InkoutMapFileContent = Right(InkoutMapFileContent, Len(InkoutMapFileContent) - 2)
    
    
    '-------------------------
    ' Merge Map
    '-------------------------
    
    
    PanelMapIndex = InStr(1, PanelMapFileContent, "ROWDATA:")
    InkoutMapIndex = InStr(1, InkoutMapFileContent, "ROWDATA:")
    IndexOffset = PanelMapIndex - InkoutMapIndex
    
    Index = InStr(1, InkoutMapFileContent, "030")
    MsgBox "Ongoing merge"
    Do While Index > 0
        
        DefectCode = mid(PanelMapFileContent, Index + IndexOffset, 3)
        MsgBox DefectCode
        If DefectCode = "000" Then
            'MsgBox "BEFORE:" & vbNewLine & PanelMapFileContent
            'MsgBox "REPLACE: " & vbNewLine & Replace(PanelMapFileContent, "000", "030", Index, 1)
        
            PanelMapFileContent = Left(PanelMapFileContent, Index - 1 + IndexOffset) & Replace(PanelMapFileContent, "000", "030", Index + IndexOffset, 1)
            'MsgBox "AFTER:" & vbNewLine & PanelMapFileContent
        End If
        Index = InStr(Index + 1 + IndexOffset, InkoutMapFileContent, "030")
    Loop
    
    MsgBox "Done merge" & PanelMapFileContent
    MergeMap = PanelMapFileContent
        
End Function

Public Function funcModifiedUBound(ByVal UBoundArray As Variant, Optional DisplayIndex As Boolean = False) As Long
    
    
    Dim LowerIndex As Long, UpperIndex As Long, Delta As Long
    Dim lastGood As Long
    
    '-------------------------------------
    ' 1. Check if Variant arr is an array
    '-------------------------------------
    If Not IsArray(UBoundArray) Then
        funcModifiedUBound = -1
        Exit Function
    End If
    
    On Error GoTo EmptyArray
    
    '----------------------------------
    ' 2. Set the Initial Looping Range
    '----------------------------------
    LowerIndex = LBound(UBoundArray)
    UpperIndex = UBound(UBoundArray)
    On Error GoTo 0
    
    lastGood = LowerIndex - 1
    
    Do While LowerIndex <= UpperIndex
        Delta = (LowerIndex + UpperIndex) \ 2
        Element = UBoundArray(Delta)
        If IsEmpty(Element) Or IsNull(Element) Or Element = "" Then
            UpperIndex = Delta - 1
            If DisplayIndex Then MsgBox "Empty at " & Delta
        Else
            lastGood = Delta
            LowerIndex = Delta + 1
            If DisplayIndex Then MsgBox "Found value at " & Delta
        End If
    Loop
    
    funcModifiedUBound = lastGood
    Exit Function

EmptyArray:
    funcModifiedUBound = -1
End Function


Public Sub ConvertDefectCode(ByVal Filename As String)
    
    Dim filePath As String
    Dim fileNum As Integer
    Dim fileContent As String
    
    filePath = Filename
    fileNum = FreeFile
    
    Open filePath For Input As #fileNum
    fileContent = ""
    Do Until EOF(fileNum)
        Line Input #fileNum, LineInstance
        fileContent = fileContent & vbNewLine & LineInstance
    Loop
    
    If fileContent = "" Then
        MsgBox "No Map Found"
        Exit Sub
    End If
    fileContent = Right(fileContent, Len(fileContent) - 2)
    fileContent = Replace(fileContent, "019", "030")
    fileContent = Replace(fileContent, "020", "030")
    fileContent = Replace(fileContent, "021", "030")
    
    'MsgBox "[" & fileContent & "]"
    
    Close #fileNum
    
    Open filePath For Output As #fileNum
    Print #fileNum, fileContent
    Close #fileNum

End Sub

Public Function GetMotherLotID(ByVal Directory As String)
    
    Dim Files As String
    Dim col As New Collection
    Dim Filename As String
    Dim FileIsMap As Boolean
    
    Files = ""
    
    Filename = Dir(Directory & IIf(Right(Directory, 1) = "*", "", "\"))
    
    Do While Filename <> ""
        
        If IsAEIFile(Filename) Then
            col.Add Filename
            
            Files = Files & Filename
        End If
        
        Filename = Dir
        
    Loop
    
    Filename = Dir(Directory & IIf(Right(Directory, 1) = "*", "", "\AEI\"))
    Do While Filename <> ""
    
        If IsAEIFile(Filename) Then
            col.Add Filename
        End If
        
        Filename = Dir
        
    Loop
    
    
    If col.Count = 0 Then
        GetMotherLotID = Empty
        Exit Function
    End If

    
    GetMotherLotID = CollectionToArray(col)
    
End Function

Private Function IsAEIFile(ByVal Filename As String) As Boolean

    
    If InStr(1, Filename, "AEI", vbTextCompare) = 0 Then Exit Function
    IsAEIFile = True

End Function

Public Function GetMapList(ByVal Directory As String)
    
    Dim Files As String
    Dim col As New Collection
    Dim Filename As String
    Dim FileIsMap As Boolean
    
    Files = ""
    
    Filename = Dir(Directory & IIf(Right(Directory, 1) = "*", "", "\"))
    
    Do While Filename <> ""
    
        If IsValidMapFile(Filename) Then
            col.Add Filename
        End If
        
        Filename = Dir
        
    Loop
    
    If col.Count = 0 Then
        GetMapList = Empty
        Exit Function
    End If

    GetMapList = CollectionToArray(col)
    
End Function

Private Function CollectionToArray(col As Collection) As Variant
    Dim arr() As String
    Dim i As Long

    ReDim arr(0 To col.Count - 1)

    For i = 1 To col.Count
        arr(i - 1) = col(i)
    Next i

    CollectionToArray = arr
End Function


Private Function IsValidMapFile(ByVal Filename As String) As Boolean

    If Len(Filename) < 6 Then Exit Function
    If InStr(1, Filename, Schedule, vbTextCompare) = 0 Then Exit Function
    If InStr(1, Filename, ".x", vbTextCompare) > 0 Then Exit Function
    If InStr(1, Filename, "AEI", vbTextCompare) > 0 Then Exit Function
    If InStr(1, Filename, "6688", vbTextCompare) > 0 Then Exit Function
    If InStr(1, Filename, "OUT", vbTextCompare) > 0 Then Exit Function

    IsValidMapFile = True

End Function






