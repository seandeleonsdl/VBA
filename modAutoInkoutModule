Public Sub subGetSubfolders(ByVal Directory As String, ByRef r As Long)

    Dim fso As Object
    Dim ParentFolder As Object
    Dim Subfolder As Object

    Set fso = CreateObject("Scripting.FileSystemObject")
    Set ParentFolder = fso.GetFolder(Directory)
    
    For Each Subfolder In ParentFolder.Subfolders
        
        ThisWorkbook.Sheets("Subfolders").Cells(r, 1).Value = Subfolder.Name
        ThisWorkbook.Sheets("Subfolders").Cells(r, 2).Value = Subfolder.Path
        'Stream = Stream & "|" & Subfolder.Path
        r = r + 1
        subGetSubfolders Subfolder.Path, r
    Next Subfolder
        
End Sub

