Public Function RunFolderScan(ByVal Directory As String)

    Dim results As Variant
    Dim r As Long
    Const MAX_ROWS As Long = 100000
    
    Dim RootDir As String
    RootDir = Directory
    
    If Right(RootDir, 1) = "\" Then
        RootDir = Left(RootDir, Len(RootDir) - 1)
    End If
    
    ReDim results(1 To MAX_ROWS, 1 To 2)
    r = 0
    CheckForMap = True
    
    Call subGetSubfolders(RootDir, RootDir, results, r, CheckForMap)
    
    
    If r = 0 Then Exit Function
   
    Dim LastRow As Integer
    LastRow = ThisWorkbook.Sheets("Subfolders").Range("F" & Rows.Count).End(xlUp).Row + 1
    ThisWorkbook.Sheets("Subfolders").Range("F" & LastRow).Resize(r, 2).Value = results
        
    

End Function

Public Function subGetSubfolders(ByVal Directory As String, _
                                 ByVal RootDir As String, _
                                 ByRef data As Variant, _
                                 ByRef r As Long, _
                                 ByVal CheckForMap As Boolean) As Boolean

    Dim fso As Object
    Dim ParentFolder As Object
    Dim Subfolder As Object
    Dim RelativePath As String
    Dim maps As Variant
    Dim hasMapHere As Boolean
    Dim hasMapBelow As Boolean

    Set fso = CreateObject("Scripting.FileSystemObject")

    On Error Resume Next
    Set ParentFolder = fso.GetFolder(Directory)
    On Error GoTo 0

    If ParentFolder Is Nothing Then Exit Function

    ' -----------------------
    ' 1. Recurse ALWAYS
    ' -----------------------
    For Each Subfolder In ParentFolder.Subfolders
        If subGetSubfolders(Subfolder.Path, RootDir, data, r, CheckForMap) Then
            hasMapBelow = True
        End If
    Next Subfolder

    ' -----------------------
    ' 2. Check THIS folder
    ' -----------------------
    If CheckForMap Then
        maps = GetMapList(Directory)
        hasMapHere = Not IsEmpty(maps)
    End If

    ' -----------------------
    ' 3. Record ONLY if THIS folder has maps
    ' -----------------------
    If hasMapHere Then
        r = r + 1

        If r > UBound(data, 1) Then
            Err.Raise vbObjectError + 1, , "Array size exceeded"
        End If

        RelativePath = mid(Directory, Len(RootDir) + 2)
        data(r, 1) = RelativePath
        data(r, 2) = Directory
    End If

    ' -----------------------
    ' 4. Return info to parent
    ' -----------------------
    subGetSubfolders = hasMapHere Or hasMapBelow

End Function







