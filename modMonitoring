Private Function functionReviewKLA(ByVal KLADirectory As String) As Integer
    
    KLA_String = functionReadCSV(KLADirectory)
    If KLA_String = "" Then Exit Function
    functionReviewKLA = Int(Mid(KLA_String, InStr(1, KLA_String, "Slot") + 5, 2))
    
    'MsgBox KLA_String
    'MsgBox Int(Mid(KLA_String, InStr(1, KLA_String, "Slot") + 5, 2))
End Function

Private Function functionReadCSV(ByVal Filename As String)

    Dim FreeFileNumber As Integer, line As String, Data As Variant, allData As Collection
    Set allData = New Collection

    FreeFileNumber = FreeFile()
    Open Filename For Input As #FreeFileNumber

    RawData = ""
    Do Until EOF(FreeFileNumber)
        Line Input #FreeFileNumber, Streamline
        RawData = RawData & "$" & Streamline
    Loop
    If Len(RawData) > 0 Then RawData = Right(RawData, Len(RawData) - 1)
    

    Close FreeFileNumber
    
    functionReadCSV = RawData

End Function

Private Function functionListChildren(ByVal Directories As Variant, PropertyFilter As String, Optional ByVal TextFilter As String = "", Optional DisplayAsFilepath As Boolean = True) As Variant
    
    'On Error GoTo ErrorHandling
    
    Subdirectories = ""
    
    For Each Directory In Directories
    
        '-----------------------------------
        ' Check if Directory is a Directory
        '-----------------------------------
        DirectoryIsDirectory = (GetAttr(Directory) And vbDirectory) = vbDirectory
        
        If DirectoryIsDirectory Then
            'MsgBox Directory & "\" & TextFilter & "*"
            Subdirectory_Folder = Dir(Directory & "\" & TextFilter & "*", vbDirectory)
        End If
        
        Do While Subdirectory_Folder <> ""
            
            
            Subdirectories = Subdirectories & "|" & IIf(DisplayAsFilepath, Directory & "\", "") & Subdirectory_Folder
            Subdirectory_Folder = Dir
                
        Loop
        
    Next
    If Subdirectories <> "" Then Subdirectories = Right(Subdirectories, Len(Subdirectories) - 1)
    'MsgBox Replace(Subdirectories, "|", vbNewLine)
    
    FilteredSubdirectories = ""
    For Each Subdirectory In Split(Subdirectories, "|")
     '   MsgBox Subdirectory
        PassFilter = Application.Run(PropertyFilter, Subdirectory)
        If PassFilter Then FilteredSubdirectories = FilteredSubdirectories & "|" & Subdirectory
    Next
    
    'MsgBox "Filteredsubs: " & FilteredSubdirectories
    If FilteredSubdirectories <> "" Then FilteredSubdirectories = Right(FilteredSubdirectories, Len(FilteredSubdirectories) - 1)
    'MsgBox Replace(FilteredSubdirectories, "|", vbNewLine)
    
    functionListChildren = Split(FilteredSubdirectories, "|")
    
    Exit Function
    
'ErrorHandling:
    'MsgBox "Error encountered." & vbNewLine & "[" & Directory & "]"
    
End Function

Private Function functionModifiedUBound(ByVal UBoundArray As Variant) As Integer
    
    If IsEmpty(UBoundArray) Then
        functionModifiedUBound = 0
        Exit Function
    End If
    MaxLimit = UBound(UBoundArray)
    Index = MaxLimit
    Do While True
        
        If UBoundArray(Index) = "" Then
            
            LastIndex = Index
            Index = Int(Index / 2)
            'MsgBox "Element is empty; Changing index from " & LastIndex & " to " & Index
        Else
            
            Index = Index + (LastIndex - Index) / 2
            LastIndex = Index * 2 - LastIndex
            'MsgBox "Element found for Array(" & LastIndex & "); Changing index from " & LastIndex & " to " & Index & vbNewLine & UBoundArray(LastIndex)
            
            If Abs(LastIndex - Index) < 1 Then Exit Do
        
        End If
    
    Loop
    
    functionModifiedUBound = LastIndex
    
End Function



Private Function functionListSubdirectories( _
    ByVal Directories As Variant, _
    PropertyFilter As String, Optional ByVal TextFilter As String = "", _
    Optional DisplayAsFilepath As Boolean = True, Optional DisplayArray As Boolean = False _
    ) As Variant
    
    'On Error GoTo ErrorHandling
    
    Dim Subdirectories() As Variant, SubdirectoryCount As Integer
    ReDim Subdirectories(1 To 2000)
    SubdirectoryCount = 0
    
    For Each Directory In Directories
    
        If Directory = "" Then Exit For
        '-----------------------------------
        ' Check if Directory is a Director
        '-----------------------------------
        DirectoryIsDirectory = (GetAttr(Directory) And vbDirectory) = vbDirectory
        If DirectoryIsDirectory Then Subdirectory_Folder = Dir(Directory & "\" & TextFilter & "*", vbDirectory)
        
        
        Do While Subdirectory_Folder <> ""
            
            SubdirectoryCount = SubdirectoryCount + 1
            Subdirectories(SubdirectoryCount) = IIf(DisplayAsFilepath, Directory & "\", "") & Subdirectory_Folder
            Subdirectory_Folder = Dir
                
        Loop
        
    Next
    'functionDisplayArray Subdirectories
    If SubdirectoryCount = 0 Then Exit Function
    
    
    Dim FilteredSubdirectories() As Variant, FilteredSubdirectoryCount As Integer
    'ReDim FilteredSubdirectories(1 To SubdirectoryCount)
    ReDim FilteredSubdirectories(1 To 2000)
    FilteredSubdirectoryCount = 0
    
    For i = 1 To SubdirectoryCount
        Subdirectory = Subdirectories(i)
        PassFilter = Application.Run(PropertyFilter, Subdirectory)
        If PassFilter Then
            FilteredSubdirectoryCount = FilteredSubdirectoryCount + 1
            FilteredSubdirectories(FilteredSubdirectoryCount) = Subdirectory
        End If
    Next
    
    'ReDim Preserve FilteredSubdirectories(1 To FilteredSubdirectoryCount)
    
    If DisplayArray Then functionDisplayArray (FilteredSubdirectories)
    functionListSubdirectories = FilteredSubdirectories
    


    Exit Function
    
'rrorHandling:
 '  MsgBox "Error encountered: " & PropertyFilter
    
End Function


