Private Sub Worksheet_Change(ByVal Target As Range)
    
    
    If ThisWorkbook.Sheets("Scan Results").Range("R2").Value = True Then Exit Sub
    For Each Cell In Target
        
        If Not Intersect(Target, ThisWorkbook.Sheets("Scan Results").Range("A2")) Is Nothing Then
            ThisWorkbook.Sheets("Scan Results").Range("R2").Value = True
            ThisWorkbook.Sheets("Scan Results").Range("A2").Value = UCase(ThisWorkbook.Sheets("Scan Results").Range("A2").Value)
       '     MsgBox ThisWorkbook.Sheets("Scan Results").Range("A2").Value
