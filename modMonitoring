Private Sub functionCreateScanResultsWorksheet()
    
    Dim wsInstance As Worksheet
    Dim ScanResultsWorksheetDoesNotExist As Boolean
    
    ScanResultsWorksheetDoesNotExist = True
    
    For Each wsInstance In ThisWorkbook.Sheets
        If wsInstance.Name = "Scan Results" Then
            
            ScanResultsWorksheetDoesNotExist = False
            Exit For
        End If
    Next
        
    If ScanResultsWorksheetDoesNotExist Then
        ThisWorkbook.Sheets.Add(After:=Sheets(1)).Name = "Scan Results"
    End If
    
    Set wsScanResults = ThisWorkbook.Sheets("Scan Results")

    Dim Headers(1 To 1, 1 To 16) As String
    Headers(1, 1) = "Schedule"
    Headers(1, 2) = "Step"
    Headers(1, 3) = "Link"
    For i = 1 To 13
    
        Headers(1, 3 + i) = "S" & Format(i, "00")
         
    Next

    wsScanResults.Range("A1:P1").Value = Headers
    

End Sub



Private Function filterRecentlyScanned(SubdirectoryName As String) As Boolean
    
    Filename = Split(SubdirectoryName, "\")(UBound(Split(SubdirectoryName, "\")))
    
    FileDate = FileDateTime(SubdirectoryName)
    ScanTime = DateDiff("d", FileDate, Now)
    
    IsAFolder = (GetAttr(SubdirectoryName) And vbDirectory) = vbDirectory
    
    filterRecentlyScanned = Len(Filename) > 2 And ScanTime <= 30 And IsAFolder
     
End Function

Private Function filterGeneral(SubfolderName As String) As Boolean
    
    Filename = Split(SubfolderName, "\")(UBound(Split(SubfolderName, "\")))
    filterGeneral = Len(Filename) > 2
    
End Function

Private Function filterKLA(SubfolderName As String) As Boolean
    
    Filename = Split(SubfolderName, "\")(UBound(Split(SubfolderName, "\")))
    filterKLA = InStr(1, Filename, ".kla") > 0 And Len(Filename) > 2
    
End Function

Private Sub functionDisplayArray(ByVal DisplayArray As Variant)
    
    
    Display = ""
    For i = 1 To functionModifiedUBound(DisplayArray)
        Item = DisplayArray(i)
        If Item = "" Then Exit For
        Display = Display & Item & vbNewLine
    Next
    If Display <> "" Then Display = Left(Display, Len(Display) - 2)
    MsgBox Display
    
End Sub

Private Function functionCombineArray(ByVal Array1 As Variant, Array2 As Variant) As Variant

    Array1_Count = 0
    Array2_Count = 0
    
    'If Not IsEmpty(Array1) Then Array1_Count = UBound(Array1)
    'If Not IsEmpty(Array2) Then Array2_Count = UBound(Array2)
        
    If Not IsEmpty(Array1) Then Array1_Count = functionModifiedUBound(Array1)
    If Not IsEmpty(Array2) Then Array2_Count = functionModifiedUBound(Array2)
    
    
    Dim CombinedArray() As Variant, CombinedArray_ElementCount As Integer
    If Array1_Count + Array2_Count = 0 Then Exit Function
    
    
    ReDim CombinedArray(1 To Array1_Count + Array2_Count)
    
    CombinedArray_ElementCount = 0
    
    
    For i = 1 To Array1_Count
        
        Element = Array1(i)
        CombinedArray_ElementCount = CombinedArray_ElementCount + 1
        CombinedArray(CombinedArray_ElementCount) = Element
        
    Next
    
    For i = 1 To Array2_Count
        
        Element = Array2(i)
        CombinedArray_ElementCount = CombinedArray_ElementCount + 1
        CombinedArray(CombinedArray_ElementCount) = Element
        
    Next
    functionDisplayArray CombinedArray
    
    functionCombineArray = CombinedArray
    
End Function

